
# ==========================================
# Portfolio - Git Ignore
# ==========================================

# OS generated files
.DS_Store
Thumbs.db
Desktop.ini

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Python (if used later)
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# Node.js (if using npm later)
node_modules/
.npm/
dist/
.cache/
.parcel-cache/

# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary and backup files
*.tmp
*.temp
*.bak
*.backup

# Local development files
coverage/
.nyc_output/

